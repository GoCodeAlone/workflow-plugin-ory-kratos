{
  "name": "workflow-plugin-ory-kratos",
  "version": "0.1.0",
  "description": "Ory Kratos identity provider plugin",
  "author": "GoCodeAlone",
  "license": "MIT",
  "type": "external",
  "tier": "community",
  "private": false,
  "minEngineVersion": "0.64.0",
  "required_secrets": [
    {
      "name": "ORY_KRATOS_ADMIN_URL",
      "sensitive": false,
      "description": "Ory Kratos Admin API base URL. Referenced as ${ORY_KRATOS_ADMIN_URL}. Keep this server-side only.",
      "prompt": "Ory Kratos Admin API URL"
    },
    {
      "name": "ORY_KRATOS_PUBLIC_URL",
      "sensitive": false,
      "description": "Ory Kratos Public API base URL for self-service browser flows. Referenced as ${ORY_KRATOS_PUBLIC_URL}.",
      "prompt": "Ory Kratos Public API URL"
    },
    {
      "name": "ORY_KRATOS_API_KEY",
      "sensitive": true,
      "description": "Bearer token for protected Ory Kratos Admin API deployments. Referenced as ${ORY_KRATOS_API_KEY}. Leave blank only for private self-hosted admin endpoints that do not use bearer auth.",
      "prompt": "Ory Kratos Admin API bearer token"
    }
  ],
  "keywords": ["ory", "kratos", "identity", "iam", "authentication", "passwordless"],
  "homepage": "https://github.com/GoCodeAlone/workflow-plugin-ory-kratos",
  "repository": "https://github.com/GoCodeAlone/workflow-plugin-ory-kratos",
  "capabilities": {
    "configProvider": false,
    "moduleTypes": ["ory.kratos"],
    "stepTypes": [
      "step.ory_kratos_auth_provider_describe",
      "step.ory_kratos_identity_create",
      "step.ory_kratos_identity_get",
      "step.ory_kratos_identity_list",
      "step.ory_kratos_identity_update",
      "step.ory_kratos_identity_delete",
      "step.ory_kratos_login_flow_create",
      "step.ory_kratos_login_flow_get",
      "step.ory_kratos_registration_flow_create",
      "step.ory_kratos_registration_flow_get",
      "step.ory_kratos_recovery_flow_create",
      "step.ory_kratos_recovery_flow_get",
      "step.ory_kratos_verification_flow_create",
      "step.ory_kratos_verification_flow_get",
      "step.ory_kratos_identity_recovery_code",
      "step.ory_kratos_identity_sessions_delete"
    ],
    "triggerTypes": []
  },
